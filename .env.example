# From @BotFather in Telegram: /newbot, then copy the token.
TELEGRAM_BOT_TOKEN=

# polling (default) or webhook. Webhook needs a public https address.
TELEGRAM_MODE=polling

# Webhook mode only: the app's public address, e.g. https://my-bot.fadehost.app
WEBHOOK_URL=
# Webhook mode, recommended: a random string; Telegram sends it with every update.
WEBHOOK_SECRET=
# Webhook mode: the port to listen on (FadeHost sets PORT for you).
PORT=3000

# LAREPER_API_KEY нужен для генерации ответов.
LAREPER_API_KEY=
# ID владельца для команд /chats, /stop и /on в личке бота.
OWNER_TELEGRAM_ID=
# Включает романтический сценарий в подключённых личных Business-чатах.
ROMANTIC=0
# Часы до одного повторного сообщения. 0 отключает, значение должно быть меньше 24.
NUDGE_AFTER_HOURS=12
NUDGE_COOLDOWN_HOURS=48
